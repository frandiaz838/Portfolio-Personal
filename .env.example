# Copiá este archivo a .env.local y completá lo que tengas. Todo es opcional en desarrollo.

# Token de GitHub (fine-grained, solo lectura de repos públicos).
# Sin token la API permite 60 req/h por IP; con token, 5000. El sitio funciona igual sin él.
GITHUB_TOKEN=

# Resend (formulario de contacto). Sin key, el form muestra un error amable.
RESEND_API_KEY=
# A dónde llegan los mensajes del form
CONTACT_TO_EMAIL=frandiaz838@gmail.com

# URL pública del sitio (para metadata, sitemap y OG). En Vercel se puede dejar vacía.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
